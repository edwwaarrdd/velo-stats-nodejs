FROM node:22-bookworm-slim AS build

ENV NODE_ENV=development

# better-sqlite3 ships prebuilt binaries but falls back to compiling from source.
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

# Drop the development dependencies from node_modules, leaving exactly what the
# runtime stage needs including better-sqlite3's compiled binding.
RUN npm prune --omit=dev


FROM node:22-bookworm-slim

ENV NODE_ENV=production \
    TZ=UTC \
    PORT=8000 \
    DB_DATABASE=/app/database/database.sqlite

WORKDIR /app

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY package.json ./
COPY docker/cluster.js ./dist/cluster.js
COPY database/database.sqlite ./database/database.sqlite

USER node

EXPOSE 8000

CMD ["node", "dist/cluster.js"]
